# Copy to backend/.env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Used in order if the main model is busy
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
# 0 = no "thinking" (fastest). Set -1 to leave the model default (needed for models without a thinking budget).
GEMINI_THINKING_BUDGET=0

ELEVENLABS_API_KEY=
# Any voice id from your ElevenLabs voice library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# Tiger Data (Timescale) connection string. Leave empty to use a local SQLite file.
# e.g. postgres://tsdbadmin:PASSWORD@xxxx.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require
DATABASE_URL=

# Optional shared secret. If set, the phone must send header X-App-Token with this value.
APP_TOKEN=

# Table name prefix (keeps our tables apart from others in a shared database)
DB_TABLE_PREFIX=smarteyes_
